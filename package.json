{
  "private": true,
  "name": "excalidraw-monorepo",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "excalidraw-app",
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@excalidraw/eslint-config": "1.0.3",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "3.1.0",
    "@vitest/coverage-v8": "3.0.7",
    "@vitest/ui": "2.0.5",
    "chai": "4.3.6",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "jsdom": "22.1.0",
    "pepjs": "0.5.3",
    "rewire": "6.0.0",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vite-plugin-checker": "0.7.2",
    "vite-plugin-ejs": "1.7.0",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-svgr": "4.2.0",
    "vitest": "3.0.6",
    "vitest-canvas-mock": "0.3.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "homepage": ".",
  "scripts": {
    "build-node": "bun ./scripts/build-node.js",
    "build:app:docker": "bun --cwd ./excalidraw-app build:app:docker",
    "build:app": "bun --cwd ./excalidraw-app build:app",
    "build:common": "bun --cwd ./packages/common build:esm",
    "build:element": "bun --cwd ./packages/element build:esm",
    "build:excalidraw": "bun --cwd ./packages/excalidraw build:esm",
    "build:math": "bun --cwd ./packages/math build:esm",
    "build:fractional-indexing": "bun --cwd ./packages/fractional-indexing build:esm",
    "build:laser-pointer": "bun --cwd ./packages/laser-pointer build:esm",
    "build:packages": "bun run build:common && bun run build:fractional-indexing && bun run build:laser-pointer && bun run build:math && bun run build:element && bun run build:excalidraw",
    "build:version": "bun --cwd ./excalidraw-app build:version",
    "build": "bun --cwd ./excalidraw-app build",
    "build:preview": "bun --cwd ./excalidraw-app build:preview",
    "start": "bun --cwd ./excalidraw-app start",
    "start:server": "bun scripts/start-server.js",
    "start:production": "bun --cwd ./excalidraw-app start:production",
    "start:example": "bun run build:packages && bun --cwd ./examples/with-script-in-browser start",
    "test:all": "bun run test:typecheck && bun run test:code && bun run test:server && bun run test:app --watch=false",
    "test:server": "bun test --max-concurrency=1 server/server.test.ts",
    "test:app": "vitest",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:typecheck": "tsc",
    "test:update": "bun run test:app --update --watch=false",
    "test": "bun run test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "bun run test --ui --coverage.enabled=true",
    "fix:code": "bun run test:code --fix",
    "fix": "bun run fix:code",
    "release": "bun scripts/release.js",
    "release:test": "bun scripts/release.js --tag=test",
    "release:next": "bun scripts/release.js --tag=next",
    "release:latest": "bun scripts/release.js --tag=latest",
    "rm:build": "rm -rf excalidraw-app/build excalidraw-app/dist excalidraw-app/dev-dist packages/*/dist packages/*/build examples/*/build examples/*/dist",
    "rm:node_modules": "rm -rf node_modules excalidraw-app/node_modules packages/*/node_modules",
    "clean-install": "bun run rm:node_modules && bun install"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  }
}
