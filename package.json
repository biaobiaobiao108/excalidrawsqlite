{
  "private": true,
  "name": "excalidraw-monorepo",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "excalidraw-app",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sass": "^1.104.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/runtime": "7.28.4",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.15",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.1",
    "nanoid": "5.1.16",
    "uuid": "11.1.1",
    "minimatch@^3.1.2": "3.1.5",
    "picomatch@^2.3.1": "2.3.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "homepage": ".",
  "scripts": {
    "dev": "bun server/server.ts --dev",
    "start": "NODE_ENV=production bun server-build/server.js",
    "build": "bun run build:frontend && bun run build:server",
    "build:frontend": "bun --cwd ./excalidraw-app build",
    "build:server": "bun scripts/build-server.ts",
    "test": "bun test --max-concurrency=1",
    "test:unit": "bun test --max-concurrency=1",
    "test:server": "bun test --max-concurrency=1 ./tests/server",
    "test:size": "bun run build && bun scripts/check-bundle-size.ts",
    "test:all": "bun run test:unit && bun run test:server && bun run test:typecheck && bun run test:size",
    "test:typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.tests.json",
    "build:packages": "bun run --cwd packages/common build:esm && bun run --cwd packages/fractional-indexing build:esm && bun run --cwd packages/laser-pointer build:esm && bun run --cwd packages/math build:esm && bun run --cwd packages/element build:esm && bun run --cwd packages/excalidraw build:esm"
  }
}
