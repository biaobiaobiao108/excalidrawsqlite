{
  "private": true,
  "name": "excalidraw-monorepo",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "excalidraw-app",
    "packages/*"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.4",
    "sass": "^1.105.1",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@babel/runtime": "7.28.4",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16",
    "katex": "0.18.2",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.1",
    "nanoid": "5.1.16",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1",
    "minimatch@^3.1.2": "3.1.5",
    "picomatch@^2.3.1": "2.3.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "homepage": ".",
  "scripts": {
    "dev": "bun scripts/dev-cloudflare.ts",
    "build": "bun run build:frontend && bun run cf:dry-run",
    "build:frontend": "bun --cwd ./excalidraw-app build",
    "format": "bun fmt --changed=HEAD~1",
    "format:check": "bun fmt --check --changed=HEAD~1",
    "test": "bun test --check --max-concurrency=1",
    "test:unit": "bun test --check --max-concurrency=1 ./tests/unit",
    "test:server": "bun test --check --max-concurrency=1 ./tests/server",
    "test:size": "bun run build && bun scripts/check-bundle-size.ts",
    "test:all": "bun run test:unit && bun run test:server && bun run test:typecheck && bun run test:size",
    "cf:dev": "bunx wrangler dev",
    "cf:dry-run": "bunx wrangler deploy --dry-run --outdir out/cloudflare-worker",
    "cf:db:migrate:local": "bunx wrangler d1 migrations apply DB --local",
    "test:typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.tests.json",
    "build:packages": "bun run --cwd packages/common build:esm && bun run --cwd packages/fractional-indexing build:esm && bun run --cwd packages/laser-pointer build:esm && bun run --cwd packages/math build:esm && bun run --cwd packages/element build:esm && bun run --cwd packages/excalidraw build:esm"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4"
  }
}
