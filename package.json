{
  "private": true,
  "name": "excalidraw-monorepo",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "excalidraw-app",
    "packages/*"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.4",
    "sass": "^1.107.1"
  },
  "overrides": {
    "@babel/runtime": "7.29.10",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.17",
    "katex": "0.18.2",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.1",
    "nanoid": "5.1.16",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1",
    "minimatch@^3.1.2": "3.1.5",
    "picomatch@^2.3.1": "2.3.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "homepage": ".",
  "scripts": {
    "dev": "bun server/server.ts --dev",
    "start": "NODE_ENV=production bun server-build/server.js",
    "build": "bun run build:frontend && bun run build:server",
    "build:frontend": "bun --cwd ./excalidraw-app build",
    "build:server": "bun scripts/build-server.ts",
    "format": "bun fmt \"excalidraw-app/**/*.ts\" \"excalidraw-app/**/*.tsx\" \"packages/**/*.ts\" \"packages/**/*.tsx\" \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"public/*.js\" \"*.d.ts\" package.json \"excalidraw-app/package.json\" \"packages/*/package.json\" tsconfig.json tsconfig.tests.json",
    "format:check": "bun run format --check",
    "test": "bun test --check --max-concurrency=1",
    "test:unit": "bun test --check --max-concurrency=1 ./tests/unit",
    "test:server": "bun test --check --max-concurrency=1 ./tests/server",
    "test:size": "bun run build && bun scripts/check-bundle-size.ts",
    "test:all": "bun run test:typecheck && bun run test:unit && bun run test:server && bun run test:size",
    "test:typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.tests.json",
    "build:packages": "bun run --cwd packages/common build:esm && bun run --cwd packages/fractional-indexing build:esm && bun run --cwd packages/laser-pointer build:esm && bun run --cwd packages/math build:esm && bun run --cwd packages/element build:esm && bun run --cwd packages/excalidraw build:esm"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  }
}
