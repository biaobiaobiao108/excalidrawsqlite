{
  "name": "excalidraw-app",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 edge version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 ios_saf version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "i18next-browser-languagedetector": "6.1.4",
    "idb-keyval": "6.0.3",
    "jotai": "2.11.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "scripts": {
    "build-node": "bun ./scripts/build-node.js",
    "build:app:docker": "vite build",
    "build:app": "vite build",
    "build:version": "bun ../scripts/build-version.js",
    "build": "bun run build:app && bun run build:version",
    "start": "vite",
    "start:production": "bun run build && bun run serve",
    "serve": "bun ../scripts/serve-static.ts --dir build --host localhost --port 5001",
    "build:preview": "bun run build && vite preview --port 5000"
  }
}
