{
  "name": "excalidraw-app",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 edge version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 ios_saf version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.3.0",
    "jotai": "^2.12.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "scripts": {
    "build:app:docker": "bun ../scripts/build-frontend.ts",
    "build:app": "bun ../scripts/build-frontend.ts",
    "build:version": "bun ../scripts/build-version.js",
    "build": "bun run build:app && bun run build:version",
    "start": "bun ../server/server.ts --dev",
    "start:production": "bun run build && bun run serve",
    "serve": "bun ../scripts/serve-static.ts --dir build --host localhost --port 5001",
    "build:preview": "bun run build && bun run serve"
  }
}
